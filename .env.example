# Copy this file to .env and replace the placeholders. NEVER commit .env.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://event_user:CHANGE_ME@localhost:5432/event_management

# Used only by pytest. Must be a DIFFERENT database whose name contains "test"
# (tests drop and recreate all tables in it).
TEST_DATABASE_URL=postgresql+asyncpg://event_user:CHANGE_ME@localhost:5432/event_management_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
